# AI 写作助手 - 环境变量配置示例
# 复制此文件为 .env 并填入实际的值

# ==================== OpenAI API 配置 ====================

# OpenAI API 密钥
# 获取地址: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# AI 模型配置
# 可选值: gemini-2.5-pro（复杂任务）, gemini-2.5-flash（中等任务）, gemini-2.5-flash-lite（简单任务）
VITE_OPENAI_MODEL=gemini-2.5-pro

# ==================== API 配置 ====================

# 后端 API 地址 (如果使用自建后端)
# 留空则使用 OpenAI 官方 API
VITE_API_URL=http://localhost:8000

# ==================== 开发配置 ====================

# 是否使用模拟 AI API (true/false)
# 设置为 true 时使用模拟数据，不调用真实 API，适合开发测试
# 设置为 false 时使用真实 OpenAI API
VITE_USE_MOCK_AI=false

# ==================== 说明 ====================

# 1. 如何获取 OpenAI API Key:
#    - 访问 https://platform.openai.com/api-keys
#    - 注册/登录 OpenAI 账号
#    - 创建新的 API Key
#    - 复制并粘贴到 VITE_OPENAI_API_KEY

# 2. 关于 API 使用:
#    - API 是按使用量计费的
#    - 建议设置使用限额避免超支
#    - 项目统一使用 Google Gemini 系列模型，性价比高

# 3. 模拟模式:
#    - 开发阶段建议设置 VITE_USE_MOCK_AI=true
#    - 这样可以避免消耗 API 配额
#    - 功能测试完成后再设置为 false 使用真实 API

# 4. 安全提示:
#    - 不要将 .env 文件提交到 Git 仓库
#    - .env 文件已添加到 .gitignore
#    - API Key 泄露可能导致费用损失
