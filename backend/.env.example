# 应用配置
APP_NAME=文枢AI
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置
# 使用 PostgreSQL（需要先安装 PostgreSQL 15+）
DATABASE_URL=postgresql+asyncpg://novelaide:novelaide_password@localhost:5432/novelaide
DB_ECHO=False

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# OpenSearch 配置
# 本机运行后端 + Docker OpenSearch: http://localhost:9200
# Docker Compose 内运行后端: http://opensearch:9200
OPENSEARCH_HOSTS=http://localhost:9200
OPENSEARCH_INDEX_NAME=novel_chapter_vectors
OPENSEARCH_USE_SSL=False
OPENSEARCH_VERIFY_CERTS=False
OPENSEARCH_TIMEOUT_SECONDS=10

# JWT 配置
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS 配置
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# OpenAI 配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://204992.xyz/v1

# 模型配置 - 统一使用 Gemini 系列模型
OPENAI_MODEL=gemini-2.5-pro

# ==================== 支持的模型 ====================
# 项目统一使用 Google Gemini 系列模型，根据任务复杂度自动选择：
#
# 1. gemini-2.5-flash-lite  - 简单任务（$0.10/M input, $0.40/M output）
#    适用场景：质量评估、文本分类、简单问答、关键词提取、AI痕迹检测
#
# 2. gemini-2.5-flash       - 中等任务（$0.30/M input, $2.50/M output）
#    适用场景：文本润色、扩写、摘要、翻译、评审分析
#
# 3. gemini-2.5-pro         - 复杂任务（$1.25/M input, $10.00/M output）
#    适用场景：内容创作、故事规划、角色设计、深度分析、图书分析
#
# 说明：系统会根据 ModelSelector 自动选择合适的模型，无需手动切换

# 图书分析专用模型配置
BOOK_ANALYSIS_MODEL=gemini-2.5-flash-lite  # 图书分析使用快速模型
BOOK_ANALYSIS_TIMEOUT=60  # 图书分析超时60秒

# 文件上传配置
MAX_UPLOAD_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Sentry 配置 (可选)
SENTRY_DSN=

# 管理员账号
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Fact Retrieval（固定 LightRAG）
FACT_RETRIEVAL_BACKEND=lightrag
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_QUERY_PATH=/query
LIGHTRAG_TIMEOUT_SECONDS=300
LIGHTRAG_MODE=hybrid
LIGHTRAG_TOP_K=20
LIGHTRAG_ENABLE_RERANK=true

# Reranker 服务（bge-reranker，Explore 段落精确定位）
RERANKER_BASE_URL=http://localhost:7997
