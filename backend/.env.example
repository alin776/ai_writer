# 应用配置
APP_NAME=NovelAIde
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置
# 使用 PostgreSQL（需要先安装 PostgreSQL 15+）
DATABASE_URL=postgresql+asyncpg://novelaide:novelaide_password@localhost:5432/novelaide
DB_ECHO=False

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# JWT 配置
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS 配置
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# OpenAI 配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://204992.xyz/v1

# 模型配置 - 支持的模型列表见下方注释
OPENAI_MODEL=gpt-5

# ==================== 推荐模型 ====================
# 1. GPT-5 系列（最新，推荐）
#    OPENAI_MODEL=gpt-5                 # 最新旗舰模型
#    OPENAI_MODEL=gpt-5-minimal          # 轻量版
#    OPENAI_MODEL=gpt-5-low              # 低配版
#    OPENAI_MODEL=gpt-5-medium           # 中等版（推荐平衡）
#    OPENAI_MODEL=gpt-5-high             # 高配版
#    OPENAI_MODEL=gpt-5-codex            # 编程专用
#    OPENAI_MODEL=gpt-5-codex-medium     # 编程中等版

# 2. Claude 系列（Anthropic，中文友好）
#    OPENAI_MODEL=claude-sonnet-4-5-20250923   # Claude 4.5 Sonnet（推荐）
#    OPENAI_MODEL=claude-opus-4-20250514       # Claude 4 Opus（最强）
#    OPENAI_MODEL=claude-sonnet-4-20250514     # Claude 4 Sonnet
#    OPENAI_MODEL=claude-3-7-sonnet-20250219   # Claude 3.7 Sonnet
#    OPENAI_MODEL=claude-3-5-haiku-20241022    # Claude 3.5 Haiku（快速）

# 3. Gemini 系列（Google，免费额度大）
#    OPENAI_MODEL=gemini-2.5-pro-exp-0827      # Gemini 2.5 Pro（实验版）
#    OPENAI_MODEL=gemini-2.5-pro               # Gemini 2.5 Pro
#    OPENAI_MODEL=gemini-2.5-flash-lite        # Gemini 2.5 Flash Lite（快速）
#    OPENAI_MODEL=gemini-2.0-flash-free        # Gemini 2.0 Flash（免费）

# 4. DeepSeek 系列（国产，中文强，便宜）
#    OPENAI_MODEL=deepseek-v3-2            # DeepSeek V3.2（最新）
#    OPENAI_MODEL=deepseek-v3-1-terminus   # DeepSeek V3.1 Terminus
#    OPENAI_MODEL=deepseek-v3-1            # DeepSeek V3.1
#    OPENAI_MODEL=deepseek-v3              # DeepSeek V3（推荐性价比）
#    OPENAI_MODEL=deepseek-r1-70b-free     # DeepSeek R1 70B（免费）
#    OPENAI_MODEL=deepseek-r1-free         # DeepSeek R1（免费）

# 5. 通义千问（阿里，中文优化）
#    OPENAI_MODEL=qwen3-coder-plus         # 通义千问代码增强版
#    OPENAI_MODEL=qwen3-coder-flash        # 通义千问代码快速版
#    OPENAI_MODEL=qwen3-coder              # 通义千问代码版
#    OPENAI_MODEL=qwen3-max                # 通义千问旗舰版
#    OPENAI_MODEL=qwen-v1-72b-free         # Qwen 72B（免费）

# 6. Kimi（月之暗面，长上下文）
#    OPENAI_MODEL=kimi-k2-6685             # Kimi K2 Instruct
#    OPENAI_MODEL=kimi-k2                  # Kimi K2（月球版）

# 7. 智谱AI（GLM，国产）
#    OPENAI_MODEL=glm-4-5                  # GLM 4.5

# 8. 其他推荐免费模型
#    OPENAI_MODEL=llama-3-3-70b-free       # Meta Llama 3.3 70B（免费）
#    OPENAI_MODEL=llama-4-maverick-free    # Meta Llama 4 Maverick（免费）
#    OPENAI_MODEL=qwen-coder-32b-free      # Qwen Coder 32B（免费，编程）
#    OPENAI_MODEL=microsoft-r1-free        # Microsoft R1（免费）
#    OPENAI_MODEL=hunyuan-free             # 腾讯混元（免费）

# 文件上传配置
MAX_UPLOAD_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Sentry 配置 (可选)
SENTRY_DSN=

# 管理员账号
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
